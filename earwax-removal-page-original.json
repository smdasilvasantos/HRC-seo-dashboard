ition_login_status":"subscriber","_id":"d61d1bc","display_condition_date":"29-08-2022","display_condition_date_range":"29-08-2022 to 31-08-2022","display_condition_advanced_date":"29-08-2022"}]},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"3202e183","settings":{"editor":"<p>Take the first step towards better hearing and ear health. Contact Hear Right Canada to schedule your earwax removal appointment. Many of our clinics offer walk-in appointments for your convenience, so you can get the care you need without the wait. Visit our website or call your nearest Hear Right Canada clinic to find a location near you. Our dedicated team is here to provide you with the highest level of care and ensure your ears are free from excess earwax.<\/p>","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"178985b","display_condition_date":"29-08-2022","display_condition_date_range":"29-08-2022 to 31-08-2022","display_condition_advanced_date":"29-08-2022"}]},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":false,"elType":"column"}],"isInner":false,"elType":"section"},{"id":"6cfe45d5","settings":{"boxed_width":{"unit":"px","size":923,"sizes":[]},"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"16340a8"}]},"elements":[{"id":"71e209d8","settings":{"title":"Frequent AskedQuestions About Ear Wax Removal","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"ec6a96c"}]},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"51cd1635","settings":{"presets_options":"preset-4","tabs":[{"question":"How do I know if I have an earwax blockage?","answer":"<p><span style=\"font-weight: 400;\">Common signs include a feeling of fullness in the ear, muffled hearing, ringing, or mild discomfort. These symptoms can also point to other conditions, so if you're unsure, a quick visit to one of our clinics will give you a clear answer.<\/span><\/p>","_id":"05d5b8b"},{"question":"What happens during an earwax removal appointment?","answer":"<p><span style=\"font-weight: 400;\">A hearing care professional will first look into your ear using an otoscope to assess the situation. If removal is needed, they'll use a gentle technique suited to your ear. The whole visit is quick, and most people leave with noticeably clearer hearing.<\/span><\/p>","_id":"e464c72"},{"question":"How long does it take to see results?","answer":"<p><span style=\"font-weight: 400;\">In most cases, the difference is immediate. Once the blockage is cleared, sounds feel fuller and more natural right away. If your ears were significantly blocked, it can take a short time to adjust to hearing clearly again.<\/span><\/p>","_id":"ee5dbc6"},{"question":"Does wearing hearing aids make earwax buildup worse?","answer":"<p><span style=\"font-weight: 400;\">It can. Hearing aids sit in the ear canal and may interfere with the ear's natural ability to move wax outward. Regular check-ups help catch buildup before it affects your hearing or your devices.<\/span><\/p>","_id":"1b9bbc4"},{"question":"Can earwax affect my hearing aid performance?","answer":"<p><span style=\"font-weight: 400;\">Yes. Wax is one of the most common causes of hearing aid malfunction, blocking the receiver and reducing sound quality. Keeping your ears clear helps your devices work as intended.<\/span><\/p>","_id":"9a184bb"},{"_id":"49140fe","question":"Do I need an appointment for earwax removal?","answer":"<p><span style=\"font-weight: 400;\">Most Hear Right Canada clinics welcome walk-ins, but booking ahead is strongly recommended to avoid waiting. Use our clinic locator to find your nearest location and check availability.<\/span><\/p>"}],"enable_toggle_layout":"","row_gap":{"unit":"px","size":13,"sizes":[]},"enable_seperator":"","uael_box_border_width":{"unit":"px","top":"1","right":"1","bottom":"1","left":"1","isLinked":true},"uael_border_radius":{"unit":"px","top":"5","right":"5","bottom":"5","left":"5","isLinked":true},"heading_tag":"h4","uael_title_background":"#259B99","uael_title_color":"#F2F2F2","title_padding":{"unit":"px","top":"15","right":"15","bottom":"15","left":"15","isLinked":true},"uael_content_color":"#302F2F","uael_content_padding":{"unit":"px","top":"0","right":"20","bottom":"20","left":"20","isLinked":false},"title_icon_size":{"unit":"px","size":20,"sizes":[]},"uael_icon_active_color":"#FFFFFF","uael_icon_space":{"unit":"px","size":20,"sizes":[]},"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"6af6397"}],"__globals__":{"uael_content_background":"globals\/colors?id=bd1cc41"}},"elements":[],"isInner":false,"widgetType":"uael-faq","elType":"widget"}],"isInner":false,"elType":"container"}],"page_settings":[],"version":"0.4","title":"Ear Wax Page Template","type":"page"}